<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistem Inventori</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0d6efd">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light">
  <div class="container mt-4 mb-5">
    
    <!-- TAJUK UTAMA -->
    <div class="text-center mb-4 p-3 bg-white rounded shadow-sm">
      <h3 class="mb-0 text-primary">📦 Sistem Inventori</h3>
      <small id="user-greeting" class="text-muted">Memuatkan sesi...</small>
    </div>

    <!-- KAMERA KOD BAR TERSEMBUNYI -->
    <input type="file" id="qr-file-input" accept="image/*" capture="environment" style="display:none;" onchange="prosesGambarQR(event)">

    <!-- 1. PAPARAN PROFIL / PENGGUNA -->
    <div id="view-profile" style="display: none;">
      <div class="card shadow-sm border-0">
        <div class="card-body text-center">
          <h5 class="mb-3">Sila Pilih Profil Bertugas</h5>
          <select class="form-select mb-3" id="user_select">
            <option value="">-- Memuatkan Pengguna --</option>
          </select>
          <button class="btn btn-primary w-100 py-2" onclick="simpanProfil()">Simpan & Masuk</button>
        </div>
      </div>
    </div>

    <!-- 2. PAPARAN DASHBOARD / SENARAI ITEM -->
    <div id="view-dashboard" style="display: none;">
      <div class="mb-3">
        <div class="input-group mb-2">
          <input type="text" class="form-control" id="search-input" placeholder="🔍 Cari item atau Kod Bar..." onkeyup="tapisData()">
          <button class="btn btn-outline-primary" onclick="bukaPengimbas('carian')">📷 Imbas</button>
        </div>
        <div class="btn-group w-100">
          <button class="btn btn-sm btn-outline-primary active" id="filter-semua" onclick="setFilter('semua')">Semua</button>
          <button class="btn btn-sm btn-outline-danger" id="filter-rendah" onclick="setFilter('rendah')">⚠️ Stok Rendah</button>
          <button class="btn btn-sm btn-outline-success" id="filter-mencukupi" onclick="setFilter('mencukupi')">✅ Cukup</button>
        </div>
      </div>

      <div id="app-content"></div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary flex-fill py-2" onclick="bukaBorang()">+ Kemaskini Stok</button>
        <button class="btn btn-outline-primary flex-fill py-2" onclick="bukaSejarah()">📜 Sejarah Log</button>
      </div>
      <button class="btn btn-outline-danger w-100 mt-2 btn-sm" onclick="logKeluar()">Tukar Profil</button>
    </div>

    <!-- 3. PAPARAN SEJARAH TRANSAKSI -->
    <div id="view-history" style="display: none;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">📜 Sejarah Transaksi</h5>
        <div>
          <button class="btn btn-sm btn-success me-1" onclick="muatTurunCSV()">📥 CSV</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="tutupSejarah()">✕ Kembali</button>
        </div>
      </div>
      <div id="history-content"></div>
    </div>

    <!-- 4. PAPARAN BORANG TRANSAKSI -->
    <div id="view-form" style="display: none;">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h5 class="card-title text-center mb-4">Borang Transaksi</h5>
          <form id="transForm" onsubmit="hantarData(event)">
            <div class="mb-3">
              <label class="form-label fw-bold">Pilih Item</label>
              <div class="input-group">
                <select class="form-select" id="item_id" required></select>
                <button class="btn btn-outline-primary" type="button" onclick="bukaPengimbas('borang')">📷 Imbas</button>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Jenis Transaksi</label>
              <div class="d-flex gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jenis_transaksi" value="Masuk" id="masuk" required>
                  <label class="form-check-label text-success fw-bold" for="masuk">Masuk (+)</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="jenis_transaksi" value="Keluar" id="keluar">
                  <label class="form-check-label text-danger fw-bold" for="keluar">Keluar (-)</label>
                </div>
              </div>
            </div>
            <div class="mb-4">
              <label class="form-label fw-bold">Kuantiti</label>
              <input type="number" class="form-control" id="kuantiti" min="1" required>
            </div>
            <button type="submit" class="btn btn-success w-100 py-2 mb-2" id="btn-submit">Simpan Transaksi</button>
            <button type="button" class="btn btn-outline-secondary w-100 py-2" onclick="tutupBorang()">Batal</button>
          </form>
        </div>
      </div>
    </div>

    <!-- MODAL KAMERA IMBASAN -->
    <div class="modal fade" id="scannerModal" data-bs-backdrop="static" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">📷 Imbas Kod Bar / QR</h5>
            <button type="button" class="btn-close" onclick="tutupPengimbas()"></button>
          </div>
          <div class="modal-body text-center">
            <div id="qr-reader" style="width: 100%;"></div>
            <hr>
            <button type="button" class="btn btn-outline-primary btn-sm w-100" onclick="ambilGambarKamera()">📸 Tangkap Gambar Kod</button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="app.js"></script>
</body>
</html>
